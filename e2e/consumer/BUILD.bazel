load(
    "@stage2.bzl",
    "stage2_autotools_build",
    "stage2_compiler_seed",
    "stage2_run",
    "stage2_shell_seed",
)

config_setting(
    name = "use_muslcc_seed",
    define_values = {"compiler_seed": "muslcc"},
)

config_setting(
    name = "use_zig_seed",
    define_values = {"compiler_seed": "zig"},
)

config_setting(
    name = "use_busybox_shell_seed",
    define_values = {"shell_seed": "busybox"},
)

config_setting(
    name = "use_toybox_shell_seed",
    define_values = {"shell_seed": "toybox"},
)

alias(
    name = "compiler_seed_x86_64",
    actual = select(
        {
            ":use_muslcc_seed": "@stage2.bzl//internal:default_compiler_seed_x86_64",
            ":use_zig_seed": ":zig_compiler_seed_x86_64",
        },
        no_match_error = "set --define=compiler_seed to muslcc or zig",
    ),
    visibility = ["//visibility:public"],
)

alias(
    name = "compiler_seed_aarch64",
    actual = select(
        {
            ":use_muslcc_seed": "@stage2.bzl//internal:default_compiler_seed_aarch64",
            ":use_zig_seed": ":zig_compiler_seed_aarch64",
        },
        no_match_error = "set --define=compiler_seed to muslcc or zig",
    ),
    visibility = ["//visibility:public"],
)

alias(
    name = "shell_seed_x86_64",
    actual = select(
        {
            ":use_busybox_shell_seed": "@stage2.bzl//internal:default_shell_seed_x86_64",
            ":use_toybox_shell_seed": ":toybox_shell_seed_x86_64",
        },
        no_match_error = "set --define=shell_seed to busybox or toybox",
    ),
    visibility = ["//visibility:public"],
)

alias(
    name = "shell_seed_aarch64",
    actual = select(
        {
            ":use_busybox_shell_seed": "@stage2.bzl//internal:default_shell_seed_aarch64",
            ":use_toybox_shell_seed": ":toybox_shell_seed_aarch64",
        },
        no_match_error = "set --define=shell_seed to busybox or toybox",
    ),
    visibility = ["//visibility:public"],
)

stage2_compiler_seed(
    name = "zig_compiler_seed_x86_64",
    env = {
        "AR": "%{ZIG}/zig ar",
        "CC": "%{ZIG}/zig cc -target x86_64-linux-musl -static",
        "CXX": "%{ZIG}/zig c++ --driver-mode=g++ -target x86_64-linux-musl -static",
        "LD": "%{ZIG}/zig ld.lld",
        "RANLIB": "%{ZIG}/zig ranlib",
        "ZIG_GLOBAL_CACHE_DIR": "%{ZIG}/.cache/global",
        "ZIG_LOCAL_CACHE_DIR": "%{ZIG}/.cache/local",
    },
    inputs = ["@zig_compiler_seed_x86_64//:all"],
    path = ["%{ZIG}"],
    roots = {
        "ZIG": (
            "@zig_compiler_seed_x86_64//:zig",
            "zig",
        ),
    },
)

stage2_compiler_seed(
    name = "zig_compiler_seed_aarch64",
    env = {
        "AR": "%{ZIG}/zig ar",
        "CC": "%{ZIG}/zig cc -target aarch64-linux-musl -static",
        "CXX": "%{ZIG}/zig c++ --driver-mode=g++ -target aarch64-linux-musl -static",
        "LD": "%{ZIG}/zig ld.lld",
        "RANLIB": "%{ZIG}/zig ranlib",
        "ZIG_GLOBAL_CACHE_DIR": "%{ZIG}/.cache/global",
        "ZIG_LOCAL_CACHE_DIR": "%{ZIG}/.cache/local",
    },
    inputs = ["@zig_compiler_seed_aarch64//:all"],
    path = ["%{ZIG}"],
    roots = {
        "ZIG": (
            "@zig_compiler_seed_aarch64//:zig",
            "zig",
        ),
    },
)

stage2_shell_seed(
    name = "toybox_shell_seed_x86_64",
    args = ["sh"],
    executable = "@toybox_shell_seed_x86_64//file",
)

stage2_shell_seed(
    name = "toybox_shell_seed_aarch64",
    args = ["sh"],
    executable = "@toybox_shell_seed_aarch64//file",
)

stage2_autotools_build(
    name = "hello",
    srcs = "@hello_src//:srcs",
    configure = "@hello_src//:configure",
    configure_args = [
        "--disable-nls",
        "CFLAGS=-O2 -std=gnu17",
        "LDFLAGS=--static",
    ],
)

# Run the installed binary as a second action in the same empty sandbox.
stage2_run(
    name = "hello-output",
    inputs = {"TREE": ":hello"},
    script = "%{TREE}/bin/hello > %{OUT}\n",
)
