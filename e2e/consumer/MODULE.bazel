module(name = "stage2_consumer")

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "stage2.bzl", version = "1.0.0")
local_path_override(
    module_name = "stage2.bzl",
    path = "../..",
)

compiler_seeds = use_extension("@stage2.bzl//:extensions.bzl", "compiler_seeds")
compiler_seeds.seed(
    arch = "x86_64",
    target = "//:compiler_seed_x86_64",
)
compiler_seeds.seed(
    arch = "aarch64",
    target = "//:compiler_seed_aarch64",
)

shell_seeds = use_extension("@stage2.bzl//:extensions.bzl", "shell_seeds")
shell_seeds.seed(
    arch = "x86_64",
    target = "//:shell_seed_x86_64",
)
shell_seeds.seed(
    arch = "aarch64",
    target = "//:shell_seed_aarch64",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Debian's static Bash 5.2.37 exercises the bootstrap independently of the
# default Alpine BusyBox shell.
bash_static_repo = use_repo_rule("//:bash_static_repo.bzl", "bash_static_repo")

bash_static_repo(
    name = "bash_shell_seed_x86_64",
    sha256 = "330db9da02c774a5be2e217c74cd47ff7b5560965ce4ebefe4dffa066716583f",
    urls = [
        "https://snapshot.debian.org/file/1dc1ef1d67fb2b1b80031a98b41d2faad8a5c019",
        "https://snapshot.debian.org/archive/debian/20260510T023319Z/pool/main/b/bash/bash-static_5.2.37-2%2Bb9_amd64.deb",
        "https://deb.debian.org/debian/pool/main/b/bash/bash-static_5.2.37-2%2Bb9_amd64.deb",
    ],
)

bash_static_repo(
    name = "bash_shell_seed_aarch64",
    sha256 = "eff85e8976a60957c53c2b235f15dbc4c534e241397fd2012a9bffd93e99eb92",
    urls = [
        "https://snapshot.debian.org/file/df6b894313ab052b41fbf63721d8df23210b001b",
        "https://snapshot.debian.org/archive/debian/20260510T023319Z/pool/main/b/bash/bash-static_5.2.37-2%2Bb9_arm64.deb",
        "https://deb.debian.org/debian/pool/main/b/bash/bash-static_5.2.37-2%2Bb9_arm64.deb",
    ],
)

# Zig ships the static compiler, linker, musl sysroot, and runtime needed by
# the seed contract; its ar and ranlib subcommands bootstrap GNU binutils.
http_archive(
    name = "zig_compiler_seed_x86_64",
    build_file_content = """filegroup(
    name = "all",
    srcs = ["zig"] + glob(["lib/**"]),
    visibility = ["//visibility:public"],
)
exports_files(["zig"])
""",
    sha256 = "02aa270f183da276e5b5920b1dac44a63f1a49e55050ebde3aecc9eb82f93239",
    strip_prefix = "zig-x86_64-linux-0.15.2",
    urls = ["https://ziglang.org/download/0.15.2/zig-x86_64-linux-0.15.2.tar.xz"],
)

http_archive(
    name = "zig_compiler_seed_aarch64",
    build_file_content = """filegroup(
    name = "all",
    srcs = ["zig"] + glob(["lib/**"]),
    visibility = ["//visibility:public"],
)
exports_files(["zig"])
""",
    sha256 = "958ed7d1e00d0ea76590d27666efbf7a932281b3d7ba0c6b01b0ff26498f667f",
    strip_prefix = "zig-aarch64-linux-0.15.2",
    urls = ["https://ziglang.org/download/0.15.2/zig-aarch64-linux-0.15.2.tar.xz"],
)

http_archive(
    name = "hello_src",
    build_file_content = """filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
exports_files(["configure"])
""",
    sha256 = "8d99142afd92576f30b0cd7cb42a8dc6809998bc5d607d88761f512e26c7db20",
    strip_prefix = "hello-2.12.1",
    urls = [
        "https://mirrors.kernel.org/gnu/hello/hello-2.12.1.tar.gz",
        "https://ftpmirror.gnu.org/hello/hello-2.12.1.tar.gz",
        "https://ftp.gnu.org/gnu/hello/hello-2.12.1.tar.gz",
    ],
)
